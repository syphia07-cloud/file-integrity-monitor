{
    "monitored_folders": [
        {"path": "lab", "severity": "normal"},
        {"path": "~/Downloads", "severity": "critical"}
    ],
    "ignore_patterns": ["*.tmp", "*.crdownload", "*.part", "~$*", "desktop.ini", "Thumbs.db"],
    "ignore_folders": [".git", "__pycache__", "node_modules"],
    "burst_detection": {
        "threshold": 20,
        "window_seconds": 10,
        "cooldown_seconds": 60
    }
}